<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NivarianSleepInFridges.OrbitalSupport</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldDirectory Condition="'$(RimWorldDirectory)' == ''">E:/steam/steamapps/common/RimWorld</RimWorldDirectory>
    <NivarianDirectory Condition="'$(NivarianDirectory)' == ''">$(RimWorldDirectory)/Mods/Nivarian</NivarianDirectory>
    <RimUnityReferenceDir Condition="'$(RimUnityReferenceDir)' == ''">$(MSBuildProjectDirectory)/../obj/1.7/RimUnityReferences</RimUnityReferenceDir>
    <MainAssemblyPath Condition="'$(MainAssemblyPath)' == ''">$(MSBuildProjectDirectory)/../1.7/bin/$(Configuration)/net10.0/NivarianSleepInFridges.dll</MainAssemblyPath>
    <HarmonyAssemblyPath Condition="'$(HarmonyAssemblyPath)' == ''">E:/steam/steamapps/workshop/content/294100/2009463077/1.7/Assemblies/0Harmony.dll</HarmonyAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldDirectory)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldDirectory)/UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldDirectory)/Waylith.dll" Private="false" />
    <Reference Include="Waylith.UnityCompat" HintPath="$(RimWorldDirectory)/Waylith.UnityCompat.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(HarmonyAssemblyPath)" Private="false" />
    <Reference Include="Nivarian_Race" HintPath="$(NivarianDirectory)/1.7/Core/Assemblies/Nivarian_Race.rimunity" Private="false" />
    <Reference Include="LumiParticle" HintPath="$(NivarianDirectory)/1.7/LumiParticle/Assemblies/LumiParticle.rimunity" Private="false" />
    <Reference Include="NivarianSleepInFridges" HintPath="$(MainAssemblyPath)" Private="false" />
    <Reference Include="RimUnity.Core" HintPath="$(RimUnityReferenceDir)/RimUnity.Core.dll" Private="false" />
    <Reference Include="RimUnity" HintPath="$(RimUnityReferenceDir)/RimUnity.dll" Private="false" />
  </ItemGroup>
</Project>
